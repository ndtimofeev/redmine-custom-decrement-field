<%# Rendered on the custom field's own admin form (new/edit), via
    CustomDecrementField::DecrementableIntFormat.form_partial - see
    custom_fields_helper.rb#render_custom_field_format_partial, the same
    seam every core format (Numeric, List, Version, ...) uses for its own
    extra settings. `f` is bound to the CustomField instance itself, so
    these fields read/write custom_field.increment_token,
    custom_field.decrement_token and custom_field.zero_status_id directly - both backed by the
    format_store column via the field_attributes declaration in
    DecrementableIntFormat, no separate controller/model needed. %>
<p>
  <%= f.text_field :increment_token, size: 30, placeholder: 'PRIHOD', label: :field_increment_token %>
  <em class="info"><%= l(:text_increment_token_hint) %></em>
</p>
<p>
  <%= f.text_field :decrement_token, size: 30, placeholder: 'RASHOD', label: :field_decrement_token %>
  <em class="info"><%= l(:text_decrement_token_hint) %></em>
</p>
<p>
  <%#
    Redmine's LabelledFormBuilder#select reads the label from the THIRD
    argument (options), not the fourth (html_options) - :label has to
    live in the same hash as :include_blank, or it silently falls back
    to CustomField.human_attribute_name(:zero_status_id), i.e. a bare
    "Zero status" with no translation applied at all.
  %>
  <%= f.select :zero_status_id,
        IssueStatus.all.collect { |s| [s.name, s.id.to_s] },
        { include_blank: true, label: :field_zero_status_id } %>
  <em class="info"><%= l(:text_zero_status_id_hint) %></em>
  <%#
    Misconfiguration the select itself can't show: statuses are global in
    Redmine, so every status is offered here, whatever trackers the field is
    attached to. See ZeroStatusCheck for why a status outside a tracker's
    workflow is skipped at runtime rather than applied.
  %>
  <% configured_id = f.object.zero_status_id.presence %>
  <% if configured_id %>
    <% zero_status = IssueStatus.find_by(id: configured_id) %>
    <% if zero_status.nil? %>
      <br /><em class="info custom-decrement-field-config-warning"><%= l(:text_zero_status_missing, id: configured_id) %></em>
    <% else %>
      <% without = CustomDecrementField::ZeroStatusCheck.trackers_without(f.object, zero_status) %>
      <% if without.any? %>
        <br /><em class="info custom-decrement-field-config-warning"><%= l(:text_zero_status_not_in_workflow,
              status: zero_status.name, trackers: without.map(&:name).join(', ')) %></em>
      <% end %>
    <% end %>
  <% end %>
</p>
