<%# Rendered on every page via view_layouts_base_body_bottom (see
    lib/custom_decrement_field/hooks.rb). Only emits anything on an issue
    page whose tracker actually has a decrementable field, and hands the
    JS everything it needs (per-field URL and current exhausted state) so
    it never has to make an extra request just to decide what to draw. %>
<% if @issue && CustomDecrementField::TokenConfig.fields_for_tracker(@issue.tracker).any? %>
  <%= javascript_include_tag 'custom_decrement_field', plugin: 'redmine_custom_decrement_field' %>
  <div id="custom-decrement-field-config" style="display:none" data-fields="<%=
    CustomDecrementField::TokenConfig.fields_for_tracker(@issue.tracker).map { |field|
      calculator = CustomDecrementField::StockCalculator.new(@issue, field)
      {
        id: field.id,
        url: decrement_issue_custom_field_path(issue_id: @issue.id, custom_field_id: field.id),
        exhausted: calculator.exhausted?
      }
    }.to_json
  %>"></div>
<% end %>
