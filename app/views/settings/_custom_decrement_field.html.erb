<p class="text-muted">
  This plugin does not store anything in its own settings. All
  configuration for a given field lives inside that field's own
  description. Fill in the fields below, then copy the generated line
  into the end of the description of the integer custom field you want
  to make decrementable (Administration &rarr; Custom fields), on the
  tracker it's attached to.
</p>

<p>
  <label for="cdf-token">Token (keyword)</label><br>
  <input type="text" id="cdf-token" value="MATSTOCK">
</p>
<p>
  <label for="cdf-zero-status">Status on reaching zero (optional)</label><br>
  <select id="cdf-zero-status">
    <option value=""></option>
    <% IssueStatus.all.each do |status| %>
      <option value="<%= status.id %>"><%= status.name %></option>
    <% end %>
  </select>
</p>
<p>
  <strong>Line to paste into the field's description:</strong><br>
  <code id="cdf-marker-output"></code>
</p>

<script>
  // Pure client-side computation, mirroring
  // CustomDecrementField::TokenConfig.marker on the Ruby side - there is
  // nothing to submit or persist here, this is only a convenience so
  // nobody has to hand-write the marker syntax.
  (function () {
    var tokenInput = document.getElementById('cdf-token');
    var statusSelect = document.getElementById('cdf-zero-status');
    var output = document.getElementById('cdf-marker-output');

    function render() {
      var parts = ['token=' + (tokenInput.value.trim() || 'TOKEN')];
      if (statusSelect.value) parts.push('zero-status-id=' + statusSelect.value);
      output.textContent = '<!-- custom-decrement-field: ' + parts.join('; ') + ' -->';
    }

    tokenInput.addEventListener('input', render);
    statusSelect.addEventListener('change', render);
    render();
  })();
</script>
